AI_PORT=5000
OPENAI_BASE_URL=https://api.deepseek.com
OPENAI_MODEL=deepseek-chat
OPENAI_TEMPERATURE=0.3
OPENAI_MAX_TOKENS=500
OPENAI_API_KEY=replace-with-your-api-key
DASHSCOPE_API_KEY=replace-with-your-dashscope-api-key
TTS_API_KEY=replace-with-your-tts-api-key
TTS_MODEL=qwen-tts-latest
TTS_BASE_URL=https://dashscope.aliyuncs.com/api/v1/services/aigc/multimodal-generation/generation
VECTOR_SEARCH_ENABLED=true
EMBEDDING_MODEL=BAAI/bge-small-zh-v1.5
CHROMA_PERSIST_DIR=./chroma_db
CHROMA_COLLECTION=smart_campus_knowledge
